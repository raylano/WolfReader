{
  "name": "wolfreader",
  "productName": "Wolfreader",
  "version": "1.3.0",
  "description": "Wolfreader — open EPUB books and print the whole book or just the chapters and pages you choose.",
  "main": "src/main/main.js",
  "author": "Wolfreader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "npm run build && node test/fixtures/make-fixtures.js && xvfb-run -a --server-args=\"-screen 0 1440x900x24\" node test/e2e/run-e2e.js",
    "icons": "bash scripts/make-icons.sh",
    "samples": "bash scripts/fetch-samples.sh",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "test:picker": "npm run build && xvfb-run -a --server-args=\"-screen 0 1440x900x24\" node test/e2e/page-picker.js",
    "test:tabs": "xvfb-run -a --server-args=\"-screen 0 1440x900x24\" node test/e2e/tabs.js",
    "verify:package": "node test/tools/verify-package.js",
    "verify:wine-install": "node test/tools/wine-install-check.js"
  },
  "build": {
    "appId": "app.wolfreader.desktop",
    "productName": "Wolfreader",
    "copyright": "Copyright © 2026 Wolfreader",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/icons/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "Wolfreader",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB book",
          "description": "EPUB e-book",
          "mimeType": "application/epub+zip",
          "icon": "build/icon.ico",
          "role": "Viewer"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wolfreader",
      "uninstallDisplayName": "Wolfreader",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "artifactName": "Wolfreader-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "raylano",
        "repo": "WolfReader",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdf-lib": "^1.17.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raylano/WolfReader.git"
  },
  "homepage": "https://github.com/raylano/WolfReader#readme",
  "bugs": {
    "url": "https://github.com/raylano/WolfReader/issues"
  },
  "keywords": [
    "epub",
    "reader",
    "print",
    "pdf",
    "electron",
    "windows"
  ],
  "engines": {
    "node": ">=21"
  }
}
